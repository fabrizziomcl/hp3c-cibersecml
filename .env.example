# Environment Configurations
APP_ENV=development
PORT=8000

# Data paths
DATASET_PATH=dataset/Obfuscated-MalMem2022.csv
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
EXTERNAL_DATA_DIR=data/external

# Model artifacts
MODEL_PATH=models/model.pkl
PREPROCESSOR_PATH=models/preprocessor.pkl

# Reports & logs
REPORTS_DIR=reports
LOGS_DIR=logs
LOG_LEVEL=INFO

# Training hyperparameters
RF_N_ESTIMATORS=100
RF_MAX_DEPTH=12
TEST_SIZE=0.2
SIMULATION_SPLIT_SIZE=0.2
RANDOM_STATE=42

# HPC / paralelismo (dos parámetros independientes; ver src/utils/hpc.py)
# N_JOBS: paralelismo intra-modelo del Random Forest (árboles en paralelo).
# HPC_NUM_WORKERS: fragmentos-proceso del benchmark de escalado en transformación.
# Ambos se acotan automáticamente a los núcleos disponibles, de modo que nunca
# sobre-suscriben la CPU en máquinas o runners de CI con menos núcleos.
N_JOBS=16
HPC_NUM_WORKERS=4
PCA_COMPONENTS=3

# Reentrenamiento: forzar desbalance solo en experimentación
FORCE_IMBALANCE=false
